{
  "name": "traxion-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "start:worker": "node dist/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:sandbox",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:sandbox": "vitest run --project sandbox",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@napi-rs/canvas": "1.0.13",
    "@node-rs/argon2": "2.2.2",
    "@playwright/test": "1.64.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "1.0.0",
    "bullmq": "6.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.14.0",
    "dotenv": "18.0.9",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "ioredis": "5.11.1",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.2",
    "openai": "7.43.0",
    "papaparse": "5.7.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "rate-limiter-flexible": "11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "typescript": "6.0.3",
    "unpdf": "1.9.1",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "read-excel-file": "9.3.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "tesseract.js": false,
    "msgpackr-extract": false
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
