# Copy to .env and replace every placeholder. Never commit .env.
# Values below match docker-compose.yml for local development only.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=traxion
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=traxion
DATABASE_URL=postgresql://traxion:change-me-local-db-password@localhost:5432/traxion

# Redis
REDIS_PASSWORD=change-me-local-redis-password
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379

# S3-compatible storage (SeaweedFS locally — see docker-compose.yml)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_BUCKET=traxion-qa
S3_FORCE_PATH_STYLE=true

# Sessions / uploads / jobs
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=25
OCR_MAX_PAGES=30
JOB_TIMEOUT_SECONDS=300
# Number of reverse proxies in front of the app that append X-Forwarded-For (0 for local dev).
TRUSTED_PROXY_HOPS=0

# First admin account, used only by `npm run db:seed`. Use a strong password (min 12 chars).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# Integration tests use a separate database (it is wiped between test files).
TEST_DATABASE_URL=postgresql://traxion:change-me-local-db-password@localhost:5432/traxion_test
